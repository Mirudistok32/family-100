---
import { href } from '@/lib/urls';

interface Props {
  /** О чём эта страница: одна короткая фраза. */
  topic: string;
}

const { topic } = Astro.props;
---

<aside class="callout callout--danger" aria-label="Предупреждение о теме">
  <p>
    <strong>Здесь тяжёлая тема: {topic}.</strong> Эту страницу можно пропустить или закрыть в любой
    момент. На следующие дни курса это не повлияет.
  </p>
  <p>В чужой зависимости и чужом насилии твоей вины нет.</p>
  <p>
    Если опасно прямо сейчас, уйди в безопасное место и позвони 112. Другие контакты — на странице
    <a href={href('/help/')}>«Помощь»</a>. Кнопка «Быстрый выход» вверху сразу уводит с этой
    страницы.
  </p>
</aside>
