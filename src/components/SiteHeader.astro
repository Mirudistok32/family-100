---
import { SITE_TITLE } from '@/data/days';
import { href } from '@/lib/urls';

const links = [
  { label: 'Дни', path: '/#days' },
  { label: 'Мои записи', path: '/my-family/' },
  { label: 'О курсе', path: '/about/' },
];
---

<a class="skip-link" href="#content">
  К содержанию
</a>
<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-logo hand" href={href('/')}>
      {SITE_TITLE}
    </a>
    <nav aria-label="Основное меню">
      <ul class="site-nav">
        {links.map((link) => (
          <li>
            <a href={href(link.path)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
