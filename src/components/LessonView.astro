---
import { getEntry, render } from 'astro:content';

import CapitalAudit from '@/components/CapitalAudit.astro';
import NoteField from '@/components/NoteField.astro';
import type { Lesson } from '@/lib/lessons';
import { href } from '@/lib/urls';

interface Props {
  lesson: Lesson;
  /** Подпись над заголовком: «День 1». */
  label: string;
}

const { lesson, label } = Astro.props;
const { data } = lesson;
const { Content } = await render(lesson);
const memo = await getEntry(data.memo);
const Memo = memo ? (await render(memo)).Content : undefined;
---

<article class="lesson prose" data-lesson-id={data.id} data-lesson-title={data.title}>
  <p class="hand">
    {label} · {data.minutes} минут
  </p>
  <h1>{data.title}</h1>
  <p class="lesson__goal">{data.goal}</p>

  <aside class="callout" aria-label="Вопрос дня">
    <p class="hand">вопрос, с которого начнём</p>
    <p class="lesson__question">{data.question}</p>
  </aside>

  <Content />

  <p class="no-print small">
    <a href={href('/ethics/')}>Вопросы этики всех дней</a>
  </p>

  <section class="block block--task" aria-labelledby={`${data.task.id}-title`}>
    <h2 id={`${data.task.id}-title`}>Задание</h2>
    <p>{data.task.text}</p>
    {data.task.tool === 'capital-audit' && <CapitalAudit />}
    {data.task.fields.map((field) => (
      <NoteField id={field.id} label={field.label} sensitive={field.sensitive} />
    ))}
    {data.task.link && (
      <p>
        <a href={href(data.task.link.href)}>{data.task.link.label}</a>
      </p>
    )}
    {data.task.fields.length > 0 && (
      <>
        <p class="save-problem" data-notes-problem role="alert" hidden>
          Браузер не даёт сохранить запись. Пока страница открыта, она видна в поле, но после
          закрытия пропадёт.
        </p>
        <p class="callout" data-js-off>
          Без JavaScript записи не сохраняются: текст пропадёт, когда страница закроется.
        </p>
        <p class="small muted">
          Все записи собраны на странице <a href={href('/my-family/')}>«Мои записи»</a>.
        </p>
      </>
    )}
    <slot name="task" />
  </section>

  <section class="block block--checklists" aria-labelledby={`${data.id}-checklists`}>
    <h2 id={`${data.id}-checklists`}>Чек-листы</h2>
    <div class="checklists">
      <div>
        <h3>Начинаю с себя</h3>
        <ul class="checklist" data-checklist="self">
          {data.self.map((item) => (
            <li>
              <label>
                <input type="checkbox" data-item-id={item.id} />
                <span>{item.text}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Делаем вместе</h3>
        <ul class="checklist" data-checklist="together">
          {data.together.map((item) => (
            <li>
              <label>
                <input type="checkbox" data-item-id={item.id} />
                <span>{item.text}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="save-problem" data-save-problem role="alert" hidden>
      Браузер не даёт сохранить отметку. Пока страница открыта, она действует, но после закрытия
      пропадёт.
    </p>
  </section>

  {memo && Memo && (
    <section class="callout callout--calm block--memo" aria-labelledby={`memo-${memo.data.id}`}>
      <p class="hand">памятка</p>
      <h2 id={`memo-${memo.data.id}`}>{memo.data.title}</h2>
      <Memo />
      <p class="no-print small">
        <a href={href(`/memos/${memo.data.id}/`)}>Распечатать памятку</a>
      </p>
    </section>
  )}

  <section class="block block--sources" aria-labelledby={`${data.id}-sources`}>
    <h2 id={`${data.id}-sources`}>Источники</h2>
    <ul>
      {data.sources.map((source) => (
        <li>
          {source.url ? (
            <a href={source.url} rel="noopener noreferrer">
              {source.title}
            </a>
          ) : (
            source.title
          )}
        </li>
      ))}
    </ul>
  </section>
</article>

<script>
  import '@/client/notes';
  import '@/client/progress';
</script>
