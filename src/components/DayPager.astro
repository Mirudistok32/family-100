---
import { DAYS } from '@/data/days';
import { lessonHref } from '@/lib/urls';

interface Props {
  /** Номер текущего дня. */
  day: number;
  /** Дни, у которых уже есть хотя бы один опубликованный урок. */
  available: number[];
}

const { day, available } = Astro.props;
const previous = DAYS.find((item) => item.day === day - 1 && available.includes(item.day));
const next = DAYS.find((item) => item.day === day + 1 && available.includes(item.day));
---

{(previous || next) && (
  <nav class="day-pager" aria-label="Соседние дни">
    {previous ? (
      <a class="btn btn--ghost" href={lessonHref(previous.day)} rel="prev">
        ← День {previous.day}
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a class="btn" href={lessonHref(next.day)} rel="next">
        День {next.day} →
      </a>
    )}
  </nav>
)}
