---
import DayPager from '@/components/DayPager.astro';
import LessonView from '@/components/LessonView.astro';
import { DAYS } from '@/data/days';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleLessons } from '@/lib/lessons';
import { lessonHref } from '@/lib/urls';

export async function getStaticPaths() {
  const lessons = await visibleLessons();
  const days = [...new Set(lessons.map((lesson) => lesson.data.day))];
  return days.map((day) => ({
    params: { day: String(day) },
    props: {
      day,
      available: days,
      lessons: lessons.filter((lesson) => lesson.data.day === day),
    },
  }));
}

const { day, available, lessons } = Astro.props;
const meta = DAYS.find((item) => item.day === day);
const single = lessons.length === 1 && !lessons[0]?.data.part ? lessons[0] : undefined;
const title = meta?.title ?? `День ${day}`;
---

<BaseLayout
  title={`День ${day}. ${title}`}
  description={meta?.summary ?? title}
  heavy={meta?.heavy ?? false}
>
  <div class="wrap">
    {single ? (
      <LessonView lesson={single} label={`День ${day}`} />
    ) : (
      <div class="prose">
        <p class="hand">День {day}</p>
        <h1>{title}</h1>
        <p>{meta?.summary}</p>
        <ol class="part-list">
          {lessons.map((lesson) => (
            <li>
              <a href={lessonHref(day, lesson.data.part)}>{lesson.data.title}</a>
              <span class="muted"> · {lesson.data.minutes} минут</span>
            </li>
          ))}
        </ol>
      </div>
    )}
    <DayPager day={day} available={available} />
  </div>
</BaseLayout>
