---
import DayPager from '@/components/DayPager.astro';
import LessonView from '@/components/LessonView.astro';
import { DAYS } from '@/data/days';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleLessons } from '@/lib/lessons';

export async function getStaticPaths() {
  const lessons = await visibleLessons();
  const available = lessons.map((lesson) => lesson.data.day);
  return lessons.map((lesson) => ({
    params: { day: String(lesson.data.day) },
    props: { lesson, available },
  }));
}

const { lesson, available } = Astro.props;
const { day } = lesson.data;
const meta = DAYS.find((item) => item.day === day);
---

<BaseLayout
  title={`День ${day}. ${lesson.data.title}`}
  description={meta?.summary ?? lesson.data.goal}
>
  <div class="wrap">
    <LessonView lesson={lesson} label={`День ${day}`} />
    <DayPager day={day} available={available} />
  </div>
</BaseLayout>
