---
import { DAYS, SITE_DESCRIPTION, SITE_TITLE } from '@/data/days';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { visibleLessons } from '@/lib/lessons';
import { href, lessonHref } from '@/lib/urls';

const lessons = await visibleLessons();
const available = new Set(lessons.map((lesson) => lesson.data.day));
const itemIds = (day: number) =>
  lessons
    .filter((lesson) => lesson.data.day === day)
    .flatMap((lesson) => [...lesson.data.self, ...lesson.data.together])
    .map((item) => item.id)
    .join(' ');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: pageUrl,
  inLanguage: 'ru',
  isAccessibleForFree: true,
  provider: { '@type': 'Organization', name: SITE_TITLE, url: pageUrl },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: 'PT3H',
  },
};
---

<BaseLayout description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="prose">
      <p class="hand">семь дней, один альбом</p>
      <h1>{SITE_TITLE}</h1>
      <p class="lead">
        Семь коротких дней по книге Джеймса Хьюза «Богатство семьи»: люди, знания, связи и деньги
        семьи на сто лет вперёд. С историей, живыми примерами, чек-листами и памятками.
      </p>
      <p>
        Этот курс для тех, кто создаёт семью или уже растит её и думает дальше своей жизни. Твою
        семью строишь ты.
      </p>
      <p>На один день уходит 20–30 минут. Порядок лучше сохранить, но ничего не заперто.</p>
      <p class="callout resume" data-resume hidden>
        Продолжить там, где остановились: <a href={href('/')}>урок</a>
      </p>
    </div>

    <h2 id="days">Семь дней</h2>
    <ol class="day-list">
      {DAYS.map(({ day, title, summary, section }) => (
        <li class="day-card" data-day={day}>
          <p class="hand day-card__number">
            день {day} · {section}
          </p>
          <h3 class="day-card__title">
            {available.has(day) ? <a href={lessonHref(day)}>{title}</a> : title}
          </h3>
          <p>{summary}</p>
          {!available.has(day) && <p class="small muted">Пока в работе.</p>}
          {available.has(day) && (
            <p class="small muted" data-progress-items={itemIds(day)} hidden />
          )}
        </li>
      ))}
    </ol>

    <div class="prose">
      <h2>Что останется после курса</h2>
      <ul>
        <li>Чек-листы: «Начинаю с себя» и «Делаем вместе».</li>
        <li>Памятки, которые можно распечатать.</li>
        <li>Своя семейная конституция: миссия, ценности, правила, деньги и традиции.</li>
      </ul>
      <p>
        Курс строится на союзе мужчины и женщины и их детях. Это ценность автора. Подробнее —
        <a href={href('/about/')}>на странице о курсе</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '@/client/progress';
</script>
