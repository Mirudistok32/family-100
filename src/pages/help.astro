---
import { HELPLINE_GROUPS, HELPLINES } from '@/data/helplines';
import BaseLayout from '@/layouts/BaseLayout.astro';

const dateFormat = new Intl.DateTimeFormat('ru-RU', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const humanDate = (day: string) => dateFormat.format(new Date(`${day}T00:00:00.000Z`));
---

<BaseLayout
  title="Помощь"
  description="Куда обратиться, если опасно или очень тяжело: 112, детский телефон доверия, помощь при насилии и зависимости."
  heavy
>
  <div class="wrap">
    <div class="prose">
      <p class="hand">рядом есть люди</p>
      <h1>Помощь</h1>
      <p class="lead">
        Здесь контакты живых людей, которые помогают. Курс их не заменяет. В чужой зависимости и
        чужом насилии твоей вины нет.
      </p>

      {HELPLINE_GROUPS.map((group) => (
        <section aria-labelledby={`help-${group.id}`} data-help-group={group.id}>
          <h2 id={`help-${group.id}`}>{group.title}</h2>
          <p>{group.intro}</p>
          <ul class="help-list">
            {HELPLINES.filter((item) => item.group === group.id).map((item) => (
              <li class="help-card" data-helpline={item.id}>
                <h3 class="help-card__name">{item.name}</h3>
                <p>{item.who}</p>
                <p class="help-card__phones">
                  {item.phones.map((phone) => (
                    <a class="btn help-card__phone" href={`tel:${phone.tel}`}>
                      {phone.label}
                    </a>
                  ))}
                </p>
                <p>{item.hours}</p>
                {item.site && (
                  <p>
                    <a href={item.site} rel="noopener noreferrer">
                      Сайт службы
                    </a>
                  </p>
                )}
                <p class="small muted">
                  Проверено по{' '}
                  <a href={item.source} rel="noopener noreferrer" data-helpline-source>
                    официальному сайту
                  </a>{' '}
                  <time datetime={item.checkedAt}>{humanDate(item.checkedAt)}</time>.
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <h2 id="privacy">Если устройством пользуется кто-то ещё</h2>
      <ul>
        <li>
          Кнопка «Быстрый выход» вверху сразу открывает обычный поисковый сайт, а кнопка «назад»
          сюда не вернёт.
        </li>
        <li>
          Но в истории браузера страница останется. Её можно удалить в настройках истории или с
          самого начала открывать сайт в режиме инкогнито.
        </li>
        <li>
          Номера телефонов остаются в списке звонков. Их можно удалить в телефоне после разговора.
        </li>
      </ul>

      <h2>Если номер не отвечает</h2>
      <p>
        Попробуй другую службу из списка. Если опасно, сразу звони 112. У служб бывают перерывы и
        смена номеров, поэтому рядом с каждым контактом стоит дата проверки.
      </p>
    </div>
  </div>
</BaseLayout>
